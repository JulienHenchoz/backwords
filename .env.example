# Mode en ligne (voir docs/ONLINE.md). Copier vers .env.local et remplir.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# Clé "anon" (ou "publishable") du projet : publique, protégée par les règles RLS.
VITE_SUPABASE_ANON_KEY=
# Clé publique VAPID pour les notifications push (npx web-push generate-vapid-keys).
VITE_VAPID_PUBLIC_KEY=
